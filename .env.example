APP_NAME=AI Procurement Platform
ENVIRONMENT=development
DATABASE_URL=sqlite:///./procurement.db
# Generate a random secret with python scripts/configure.py. Never deploy this file as-is.
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
AUTH_RATE_LIMIT=60
VITE_API_URL=/api/v1
