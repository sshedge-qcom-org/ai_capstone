{
  "info": {
    "name": "AI Procurement Platform - local lifecycle",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run in order against explicitly seeded development data. Set password locally. Creates a real delivered order and updates the demo vendor assignment. Do not run against production."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000/api/v1"
    },
    {
      "key": "password",
      "value": ""
    },
    {
      "key": "access_token",
      "value": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.collectionVariables.set(\"target_delivery_date\", new Date(Date.now() + 14 * 86400000).toISOString().slice(0,10));",
          "if (!pm.collectionVariables.get(\"demo_category\")) pm.collectionVariables.set(\"demo_category\", \"Postman \" + Date.now());"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{base_url}}/health",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Request succeeds\", () => pm.expect(pm.response.code).to.be.within(200, 299));"
            ]
          }
        }
      ]
    },
